workspace_root: ~/sandboxes
projects_file: ~/.config/sbx/projects.yaml
git_cache_root: ~/.cache/sbx/git
agent: claude
claude_theme: dark
# Defaults written to the sandbox's Claude settings.json at creation; empty
# leaves Claude's own default.
claude_model: claude-opus-5-5
claude_effort: high
# Memory limit per sandbox (passed as sbx create --memory). Empty uses the
# sbx default of 50% of host memory.
sandbox_memory: 8g
# Extra host directories mounted into every new sandbox at the same path.
# Read-only unless writable: true. Agents are told about them in their global
# instructions (~/.claude/CLAUDE.md or ~/.codex/AGENTS.md in the sandbox).
# Existing sandboxes keep their mounts until recreated.
# mounts:
#   - path: ~/vaults
#     description: Obsidian vaults with my notes; search them for context
host_shell: fish
# Editor for the task prompt (Ctrl-G in sbx new), as a shell command that
# takes the file to edit. Empty uses $VISUAL, then $EDITOR, then nvim.
# editor: NVIM_APPNAME=nvim-v2 nvim
# tmux (default) or rex. With rex, workspaces are Rex sessions opened by
# rex/sbx.lua and the tmux settings below are unused.
multiplexer: tmux
tmux_socket: sbx-v1
# Optional; omitted means tmux loads your normal user config.
# tmux_config: ~/.tmux.conf
# Must be Docker's native executable, not this wrapper.
docker_sbx_bin: /opt/homebrew/bin/sbx
